{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "10761556801409316710"
    }
  },
  "parameters": {
    "openAIResourceName": {
      "type": "string",
      "defaultValue": "oai-farsight",
      "metadata": {
        "description": "Name of the Azure OpenAI resource"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "westus",
      "metadata": {
        "description": "Azure region for the Azure OpenAI resource"
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "S0",
      "allowedValues": [
        "S0"
      ],
      "metadata": {
        "description": "Pricing tier for the Azure OpenAI resource"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[parameters('openAIResourceName')]",
      "location": "[parameters('location')]",
      "kind": "OpenAI",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "properties": {
        "customSubDomainName": "[parameters('openAIResourceName')]"
      }
    }
  ],
  "outputs": {
    "openAIEndpoint": {
      "type": "string",
      "metadata": {
        "description": "The endpoint URL for the Azure OpenAI resource"
      },
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('openAIResourceName')), '2024-10-01').endpoint]"
    },
    "openAIResourceName": {
      "type": "string",
      "metadata": {
        "description": "The name of the provisioned Azure OpenAI resource"
      },
      "value": "[parameters('openAIResourceName')]"
    }
  }
}